{
  "name": "@podengine/sdk",
  "version": "0.3.2",
  "description": "Official TypeScript SDK for the Pod Engine podcast intelligence API — search 4M+ podcasts, fetch metadata, transcripts, charts and more.",
  "keywords": [
    "podcast",
    "podengine",
    "podcast-api",
    "transcripts",
    "podcast-charts",
    "sdk",
    "typescript"
  ],
  "homepage": "https://www.podengine.ai/api-docs",
  "bugs": {
    "url": "https://github.com/podengine/podcast-api-client-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/podengine/podcast-api-client-js.git"
  },
  "license": "MIT",
  "author": "Pod Engine",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./openapi.json": "./openapi.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openapi.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "biome check --write --linter-enabled=false . && dprint fmt",
    "gen:client": "bun run scripts/generate-client.ts",
    "generate": "bun run scripts/generate-client.ts && biome format --write src/generated",
    "lint": "biome lint .",
    "prepublishOnly": "bun run build",
    "test": "bun test tests/",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.3",
    "@types/node": "^24.13.1",
    "dprint": "0.63.0",
    "openapi-typescript": "7.13.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
